# Copy to the file of the environment you run: .env.local, .env.dev or .env.prod.
# ENV is not a setting in these files: an ENV line here is ignored. Only the process
# environment selects the environment (main.py --env sets it); the default is local.
# A blank value means "not set".

DEBUG=
APP_HOST=
APP_PORT=
WORKERS=

# local: a full SQLAlchemy URL (default: in-memory sqlite+aiosqlite://).
DATABASE_URL=
# Optional read replica URL. Blank: reads use the writer engine.
DATABASE_READ_URL=

# dev and prod: required. The mariadb+aiomysql URL is built from these parts.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Optional MongoDB. Blank MONGO_URL: no client is created.
MONGO_URL=
# With MONGO_URL set: the database exposed as request.state.mongo_db.
MONGO_DATABASE=

# JSON list, e.g. ["https://app.example.com"]. With "*" credentials are never allowed.
CORS_ALLOW_ORIGINS=
